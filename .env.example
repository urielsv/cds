# Copy to `.env.local` for local development. Never commit the real values.
# In production these are set in the Vercel project's Environment Variables.

# ---- Upload authentication -------------------------------------------------
# A scrypt hash of the upload password. Generate with:
#   node scripts/hash-password.mjs 'your long passphrase'
# The plaintext password is never stored anywhere.
UPLOAD_PASSWORD_HASH=

# 32+ byte random secret used to sign the short-lived admin session cookie.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# ---- MusicBrainz -----------------------------------------------------------
# MusicBrainz requires a descriptive User-Agent identifying the application and
# a contact address, otherwise it will rate-limit or block the client.
# Format: AppName/Version ( contact )
MUSICBRAINZ_USER_AGENT=discoteca/0.1.0 ( you@example.com )

# ---- Storage ---------------------------------------------------------------
# Injected automatically by Vercel once a Blob store is linked to the project.
# Only needed here for local development against the real store.
BLOB_READ_WRITE_TOKEN=

# ---- Optional: Discogs (phase 2 enrichment) --------------------------------
# Personal access token from https://www.discogs.com/settings/developers
# Leave blank to disable Discogs enrichment entirely.
DISCOGS_TOKEN=
